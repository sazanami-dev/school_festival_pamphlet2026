# cp .env.example .env で開発用の設定を作成してください
POSTGRES_USER=festival
POSTGRES_PASSWORD=festival
POSTGRES_DB=festival2026

# ホストのポート（他と衝突する場合は変更）
APP_PORT=3000
DB_PORT=5433

# ホストから drizzle-kit / seed を実行するときの接続先
# （コンテナ内では compose.yaml の DATABASE_URL が使われます）
DATABASE_URL=postgres://festival:festival@localhost:5433/festival2026
