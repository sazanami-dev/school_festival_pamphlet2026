# cp .env.example .env で開発用の設定を作成してください
POSTGRES_USER=festival
POSTGRES_PASSWORD=festival
POSTGRES_DB=festival2026

# ホストのポート（他と衝突する場合は変更）
APP_PORT=3000
DB_PORT=5433

# ホストから drizzle-kit / seed を実行するときの接続先
# （コンテナ内では compose.yaml の DATABASE_URL が使われます）
DATABASE_URL=postgres://festival:festival@localhost:5433/festival2026

# スマホ等からIP直打ちでdevサーバにアクセスする場合は .env.local に設定（例: NEXT_ALLOWED_DEV_ORIGINS=192.168.0.10,192.168.0.11）
# NEXT_ALLOWED_DEV_ORIGINS=

# ---------- スタンプラリー（docs/stamp-rally-design.md 9.1） ----------
# 開発中は未設定でも動く（仮の値を使う）。本番では必ず設定する
# 秘密鍵は十分に長いランダムな値にする（例: openssl rand -base64 32）
# 交換用QR・スタッフ Cookie の署名鍵
RALLY_SECRET=
# チェックポイントQRのトークンを作る鍵（変えると掲示物を全部刷り直し）。RALLY_SECRET とは別の値にする
CHECKPOINT_SECRET=
# 交換所スタッフのPIN
STAFF_PIN=
# 開催日（カンマ区切り、例: 2026-11-21,2026-11-22）。"*" で毎日（準備・テスト用）。未設定なら開発中は毎日・本番は受け付けない
RALLY_DATES=
# 受付時間（日本時間）。空なら 10:00〜16:00。交換の締め切りだけ遅らせるときは RALLY_EXCHANGE_CLOSE
RALLY_OPEN=
RALLY_CLOSE=
RALLY_EXCHANGE_CLOSE=
